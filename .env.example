# ---------------------------------------------------------------------------
# Ring (required for camera snooze + sensor state)
# ---------------------------------------------------------------------------

# Ring refresh token (required)
# Generate with: npx -p ring-client-api ring-auth-cli
RING_REFRESH_TOKEN=

# Name of the contact sensor on your Ring Alarm (case-insensitive, partial match).
# This sensor's opens trigger the camera snooze.
DOOR_SENSOR_NAME=Front Door

# Name of the Ring camera to snooze (case-insensitive, partial match)
CAMERA_NAME=Front Door

# How long to snooze motion alerts (in minutes)
SNOOZE_MINUTES=30

# Minimum seconds between snooze triggers (prevents rapid-fire if door
# opens/closes repeatedly)
COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# IKEA Dirigera (blind sunset-close gated by Ring sensor state)
# ---------------------------------------------------------------------------

# Dirigera hub IP and access token. To pair, run:
#   npm run pair-dirigera
# It will prompt you to press the action button on the hub. Copy the token
# and IP it prints here.
#
# DIRIGERA_HOST is a starting hint, not a fixed address. The hub is a DHCP
# client, so if it stops answering here the service falls back to finding it
# over mDNS and rewrites this line with the new address. You can leave it
# blank to always start with a discovery query.
DIRIGERA_HOST=
DIRIGERA_TOKEN=

# --- Hub reachability ------------------------------------------------------
# Set DIRIGERA_DISCOVERY_ENABLED=false to pin the hub to DIRIGERA_HOST and
# never search for it (useful if you have a DHCP reservation and would rather
# a wrong address fail loudly than be silently corrected).
DIRIGERA_DISCOVERY_ENABLED=true

# Whether a newly discovered address is written back to this file.
DIRIGERA_PERSIST_HOST=true

# How long to wait for an mDNS answer, and how long a candidate address gets
# to serve an API request before it's treated as dead.
DIRIGERA_DISCOVERY_TIMEOUT_MS=10000
DIRIGERA_PROBE_TIMEOUT_MS=10000

# Reconnect backoff: doubles from MIN up to MAX, then retries at MAX forever.
DIRIGERA_RECONNECT_MIN_MS=5000
DIRIGERA_RECONNECT_MAX_MS=300000

# How often the connection is checked for liveness.
DIRIGERA_HEALTH_CHECK_MS=60000

# The event stream is pinged every 30s and the hub pongs back, so silence for
# this long means the connection is dead even in a quiet house. Only applies
# when BLIND_LEVEL_SYNC_ENABLED=true; otherwise the health check polls the
# REST API instead.
DIRIGERA_SILENCE_TIMEOUT_MS=150000

# Latitude / longitude used to compute local sunset (decimal degrees).
LATITUDE=
LONGITUDE=

# Path to the blind->sensor mapping file (relative to the project dir).
# See blind-sensor-map.json.example. If the file is missing, all blinds
# close at sunset unconditionally.
BLIND_SENSOR_MAP_FILE=blind-sensor-map.json

# After a guarded blind's sensor closes, wait this many seconds before
# actually closing the blind. Lets you walk back in and shut the door
# without the blind dropping the instant you do.
POST_CLOSE_DELAY_SECONDS=60

# ---------------------------------------------------------------------------
# SmartThings smoke-triggered auto-unlock (Ultraloq lock linked into SmartThings)
# ---------------------------------------------------------------------------
# When a Ring smoke/CO device reports an ACTIVE alarm, unlock the lock via the
# SmartThings REST API. Unlock only -- it never re-locks during an alarm.
# Leave these blank to disable the feature.
#
# Setup: create an OAuth-In app with the SmartThings CLI (see README) to get a
# client id/secret, then run ON A MACHINE WITH A BROWSER:
#   ST_CLIENT_ID=xxx ST_CLIENT_SECRET=yyy npm run pair-smartthings
# then copy the printed ST_REFRESH_TOKEN and ST_LOCK_DEVICE_ID here.

# OAuth2 client credentials from the SmartThings CLI (`smartthings apps:create`).
ST_CLIENT_ID=
ST_CLIENT_SECRET=

# OAuth2 refresh token (from `npm run pair-smartthings`). SmartThings rotates
# this on every refresh; the service auto-rewrites the new value here.
ST_REFRESH_TOKEN=

# The lock's SmartThings device ID (from `npm run pair-smartthings` output).
ST_LOCK_DEVICE_ID=

# Minimum seconds between unlock commands (prevents repeat sends while an
# alarm is chattering). Default 300.
SMOKE_UNLOCK_COOLDOWN_SECONDS=300

# Redirect URI for the one-time pairing flow. SmartThings 403s on localhost,
# so this MUST be a public HTTPS URL, and must exactly match a redirect URI
# registered on the OAuth app. httpbin echoes the ?code= back so you can read
# it. Only used by `npm run pair-smartthings`.
ST_REDIRECT_URI=https://httpbin.org/get

# ---------------------------------------------------------------------------
# Meeting-triggered smart plug (Zigbee plug paired to the SmartThings hub)
# ---------------------------------------------------------------------------
# A Mac running MeetingBar posts here when you join a meeting; the plug goes on
# and is scheduled off at the meeting's scheduled end. Reuses the ST_* OAuth
# credentials above -- do NOT create a second set: SmartThings rotates the
# refresh token on every use, so a second client silently breaks the first.
#
# Leave MEETING_PLUG_TOKEN blank to disable the whole thing.

# The plug's name in the SmartThings app. Matched exactly first, then as a
# substring, against every device that has a "switch" capability.
MEETING_PLUG_DEVICE_NAME=Logo Light

# Optional: skip the name lookup by pinning the device id outright. Find ids
# with: curl -H "Authorization: Bearer $MEETING_PLUG_TOKEN" http://pi:8787/meeting/devices
MEETING_PLUG_DEVICE_ID=

# Shared secret the Mac sends as "Authorization: Bearer ...". Required -- the
# listener stays down without it. Generate one with:
#   openssl rand -hex 24
#
# Comma-separate one token per Mac, so a machine can be revoked on its own
# without re-keying the others:
#   MEETING_PLUG_TOKEN=<personal mac token>,<work mac token>
MEETING_PLUG_TOKEN=

# Where the listener binds. 0.0.0.0 so the Mac can reach it over the LAN.
MEETING_PLUG_PORT=8787
MEETING_PLUG_HOST=0.0.0.0

# Used when MeetingBar gives us no usable end date.
MEETING_PLUG_DEFAULT_MINUTES=60

# Floor and ceiling on the computed run time. The ceiling matters most: it stops
# one bad end date (an all-day event, a mis-parsed date) leaving the plug on for
# days. A meeting longer than the ceiling just needs a second join to extend.
MEETING_PLUG_MIN_MINUTES=5
MEETING_PLUG_MAX_MINUTES=240

# true  = a plug already on when the meeting starts is left on at the end
#         (you switched it on, so it isn't ours to switch off)
# false = every meeting switches it off at the end regardless
MEETING_PLUG_RESPECT_EXISTING=true

# How often the off-time is checked. Also the worst-case lateness of an off.
MEETING_PLUG_TICK_MS=20000

# ---------------------------------------------------------------------------
# Govee permanent outdoor lights
# ---------------------------------------------------------------------------
# On at sunset (uses LATITUDE / LONGITUDE above), off at GOVEE_OFF_TIME. Most
# nights show GOVEE_DEFAULT_SCENE; in the run-up to a holiday a scene is picked
# at random from that holiday's list (the calendar is in govee-lights.mjs).
# Leave GOVEE_API_KEY blank to disable.

# From the Govee Home app: Profile -> Settings -> Apply for API Key.
GOVEE_API_KEY=

# The light's name in the Govee app. Matched exactly first, then as a substring.
GOVEE_DEVICE_NAME=Outdoor House Lights

# Scene shown on ordinary nights. Must match a scene name in the Govee app.
GOVEE_DEFAULT_SCENE=Nebula

# Off time, local 24h HH:MM.
GOVEE_OFF_TIME=23:15

# Minutes after sunset to switch on (negative = before).
GOVEE_SUNSET_OFFSET_MINUTES=0

# Days before a holiday its scenes start. Christmas ignores this and runs all
# of December; Memorial Day and Labor Day run just their three-day weekend.
GOVEE_HOLIDAY_LEAD_DAYS=7

# How often the on/off times are checked. Also the worst-case lateness.
GOVEE_TICK_MS=60000

# ---------------------------------------------------------------------------
# Level-sync retry (blinds that miss a house-wide level command)
# ---------------------------------------------------------------------------
# Dirigera levels: 0 = fully open, 100 = fully closed.
#
# Watches the hub event stream. When most blinds move to the same level and a
# few don't, the stragglers get the command re-sent. Blinds held open by an
# open door sensor, and blinds you deliberately set to a different level in the
# same breath, are left alone.

# Master switch for the feature.
BLIND_LEVEL_SYNC_ENABLED=true

# Quiet period (ms) after the last observed change before evaluating, and the
# hard cap on how long one burst may keep extending that window.
BLIND_LEVEL_SYNC_SETTLE_MS=20000
BLIND_LEVEL_SYNC_MAX_BURST_MS=120000

# Retry attempts and the gap between them (ms).
BLIND_LEVEL_SYNC_MAX_RETRIES=3
BLIND_LEVEL_SYNC_RETRY_DELAY_MS=45000

# Minimum blinds that must move together to count as a house-wide command.
# Prevents adjusting one blind by hand from triggering anything.
BLIND_LEVEL_SYNC_MIN_BURST=3

# If more than this many blinds disagree, assume a deliberate partial-house
# state rather than dropped commands, and do nothing.
BLIND_LEVEL_SYNC_MAX_STRAGGLERS=3

# Fraction of reachable blinds that must share a target level for it to count
# as the intended level.
BLIND_LEVEL_SYNC_CONSENSUS_RATIO=0.667

# Blinds rarely land exactly on target; within this many points counts as there.
BLIND_LEVEL_SYNC_TOLERANCE=2

# When the house is opened fully (level 0), drive it to this level instead --
# 3 means 3% closed / 97% open. Set BLIND_FULL_OPEN_NUDGE=false to disable.
BLIND_FULL_OPEN_NUDGE=true
BLIND_FULL_OPEN_NUDGE_LEVEL=3
