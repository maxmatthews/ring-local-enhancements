# ---------------------------------------------------------------------------
# Ring (required for camera snooze + sensor state)
# ---------------------------------------------------------------------------

# Ring refresh token (required)
# Generate with: npx -p ring-client-api ring-auth-cli
RING_REFRESH_TOKEN=

# Name of the contact sensor on your Ring Alarm (case-insensitive, partial match).
# This sensor's opens trigger the camera snooze.
DOOR_SENSOR_NAME=Front Door

# Name of the Ring camera to snooze (case-insensitive, partial match)
CAMERA_NAME=Front Door

# How long to snooze motion alerts (in minutes)
SNOOZE_MINUTES=30

# Minimum seconds between snooze triggers (prevents rapid-fire if door
# opens/closes repeatedly)
COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# IKEA Dirigera (blind sunset-close gated by Ring sensor state)
# ---------------------------------------------------------------------------

# Dirigera hub IP and access token. To pair, run:
#   npm run pair-dirigera
# It will prompt you to press the action button on the hub. Copy the token
# and IP it prints here.
DIRIGERA_HOST=
DIRIGERA_TOKEN=

# Latitude / longitude used to compute local sunset (decimal degrees).
LATITUDE=
LONGITUDE=

# Path to the blind->sensor mapping file (relative to the project dir).
# See blind-sensor-map.json.example. If the file is missing, all blinds
# close at sunset unconditionally.
BLIND_SENSOR_MAP_FILE=blind-sensor-map.json

# After a guarded blind's sensor closes, wait this many seconds before
# actually closing the blind. Lets you walk back in and shut the door
# without the blind dropping the instant you do.
POST_CLOSE_DELAY_SECONDS=60

# ---------------------------------------------------------------------------
# SmartThings smoke-triggered auto-unlock (Ultraloq lock linked into SmartThings)
# ---------------------------------------------------------------------------
# When a Ring smoke/CO device reports an ACTIVE alarm, unlock the lock via the
# SmartThings REST API. Unlock only -- it never re-locks during an alarm.
# Leave these blank to disable the feature.
#
# Setup: create an OAuth-In app with the SmartThings CLI (see README) to get a
# client id/secret, then run ON A MACHINE WITH A BROWSER:
#   ST_CLIENT_ID=xxx ST_CLIENT_SECRET=yyy npm run pair-smartthings
# then copy the printed ST_REFRESH_TOKEN and ST_LOCK_DEVICE_ID here.

# OAuth2 client credentials from the SmartThings CLI (`smartthings apps:create`).
ST_CLIENT_ID=
ST_CLIENT_SECRET=

# OAuth2 refresh token (from `npm run pair-smartthings`). SmartThings rotates
# this on every refresh; the service auto-rewrites the new value here.
ST_REFRESH_TOKEN=

# The lock's SmartThings device ID (from `npm run pair-smartthings` output).
ST_LOCK_DEVICE_ID=

# Minimum seconds between unlock commands (prevents repeat sends while an
# alarm is chattering). Default 300.
SMOKE_UNLOCK_COOLDOWN_SECONDS=300

# Redirect URI for the one-time pairing flow. SmartThings 403s on localhost,
# so this MUST be a public HTTPS URL, and must exactly match a redirect URI
# registered on the OAuth app. httpbin echoes the ?code= back so you can read
# it. Only used by `npm run pair-smartthings`.
ST_REDIRECT_URI=https://httpbin.org/get

# ---------------------------------------------------------------------------
# Level-sync retry (blinds that miss a house-wide level command)
# ---------------------------------------------------------------------------
# Dirigera levels: 0 = fully open, 100 = fully closed.
#
# Watches the hub event stream. When most blinds move to the same level and a
# few don't, the stragglers get the command re-sent. Blinds held open by an
# open door sensor, and blinds you deliberately set to a different level in the
# same breath, are left alone.

# Master switch for the feature.
BLIND_LEVEL_SYNC_ENABLED=true

# Quiet period (ms) after the last observed change before evaluating, and the
# hard cap on how long one burst may keep extending that window.
BLIND_LEVEL_SYNC_SETTLE_MS=20000
BLIND_LEVEL_SYNC_MAX_BURST_MS=120000

# Retry attempts and the gap between them (ms).
BLIND_LEVEL_SYNC_MAX_RETRIES=3
BLIND_LEVEL_SYNC_RETRY_DELAY_MS=45000

# Minimum blinds that must move together to count as a house-wide command.
# Prevents adjusting one blind by hand from triggering anything.
BLIND_LEVEL_SYNC_MIN_BURST=3

# If more than this many blinds disagree, assume a deliberate partial-house
# state rather than dropped commands, and do nothing.
BLIND_LEVEL_SYNC_MAX_STRAGGLERS=3

# Fraction of reachable blinds that must share a target level for it to count
# as the intended level.
BLIND_LEVEL_SYNC_CONSENSUS_RATIO=0.667

# Blinds rarely land exactly on target; within this many points counts as there.
BLIND_LEVEL_SYNC_TOLERANCE=2

# When the house is opened fully (level 0), drive it to this level instead --
# 3 means 3% closed / 97% open. Set BLIND_FULL_OPEN_NUDGE=false to disable.
BLIND_FULL_OPEN_NUDGE=true
BLIND_FULL_OPEN_NUDGE_LEVEL=3
