{
  "name": "ring-local-enhancements",
  "version": "1.1.0",
  "description": "Local-network enhancements for a Ring + Dirigera home: snooze camera alerts on door open, and gate Dirigera blind sunset-close on door state",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "start": "node index.mjs",
    "test": "node test-level-sync.mjs",
    "diag": "node diag-level-sync.mjs",
    "deploy": "./deploy.sh",
    "auth": "npx -p ring-client-api ring-auth-cli",
    "pair-dirigera": "npx dirigera authenticate",
    "pair-smartthings": "node pair-smartthings.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dirigera": "^1.8.1",
    "ring-client-api": "^14.3.0",
    "suncalc": "^1.9.0"
  }
}
